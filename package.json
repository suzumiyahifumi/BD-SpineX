{
  "name": "bd-spinex",
  "version": "2.28.10",
  "private": true,
  "description": "BrownDust II mod management and installation for Mac PlayCover.",
  "license": "GPL-3.0-only",
  "main": "dist/app/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 dist/app/main/index.js dist/app/preload/index.cjs && electron .\"",
    "tauri:clean": "node scripts/clean-appledouble.mjs",
    "tauri:prepare": "npm run tauri:clean && node scripts/ensure-loader.mjs",
    "tauri:dev": "npm run tauri:prepare && COPYFILE_DISABLE=1 CARGO_TARGET_DIR=\"${TMPDIR:-/tmp}/bd-spinex-tauri-target\" tauri dev",
    "tauri:build": "npm run tauri:prepare && COPYFILE_DISABLE=1 CARGO_TARGET_DIR=\"${TMPDIR:-/tmp}/bd-spinex-tauri-target\" tauri build",
    "build": "tsc -p tsconfig.main.json && vite build",
    "build:backends": "node scripts/build-backends.mjs",
    "build:loader": "node scripts/build-loader.mjs",
    "gen:glass": "node scripts/gen-glass-maps.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "dist:mac": "npm run build:backends && npm run release:prepare && npm run build && node scripts/package-electron-mac.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "electron ."
  },
  "build": {
    "appId": "com.bdspinex.manager",
    "productName": "BD-SpineX",
    "asar": true,
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "dist/**/*",
      "!**/._*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "manager-data/versions",
        "to": "manager-data/versions",
        "filter": [
          "*/shared-index.json",
          "*/shared-file-index.json",
          "!**/._*"
        ]
      },
      {
        "from": "manager-data/tools/SpineSkeletonDataConverter",
        "to": "tools/SpineSkeletonDataConverter"
      },
      {
        "from": "dist-native/uabea-patcher",
        "to": "backend/uabea-patcher",
        "filter": [
          "**/*",
          "!**/._*"
        ]
      },
      {
        "from": "dist-native/uabea-cli",
        "to": "backend/uabea-cli",
        "filter": [
          "**/*",
          "!**/._*"
        ]
      },
      {
        "from": "dist-native/unitypy-backend",
        "to": "backend/unitypy",
        "filter": [
          "**/*",
          "!**/._*"
        ]
      },
      {
        "from": "dist-native/bd2loader",
        "to": "backend/bd2loader",
        "filter": [
          "libbd2loader.dylib",
          "!**/._*"
        ]
      },
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/._*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": "-"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
