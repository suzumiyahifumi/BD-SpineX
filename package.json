{
  "name": "bd-spinex",
  "version": "0.1.0",
  "private": true,
  "description": "BrownDust II mod management and installation for Mac PlayCover.",
  "main": "dist/app/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 dist/app/main/index.js dist/app/preload/index.cjs && electron .\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "electron": "^37.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
